# Server Configuration
PORT=5000

# MongoDB Database
MONGO_URI=mongodb+srv://your_mongo_connection_string

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Email Configuration (Optional - for notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# BestSMS Configuration (Required for OTP)
# Get your API key from: https://bestsms.co.in (or your BestSMS provider)
BESTSMS_API_KEY=your_bestsms_api_key_here
BESTSMS_SENDER_ID=GOLDAP
BESTSMS_API_URL=https://api.bestsms.co.in/v2/send-sms
BESTSMS_TEMPLATE_ID=your_template_id_here

# SMS Provider
SMS_PROVIDER=bestsms

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Service Account (JSON format for push notifications)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}